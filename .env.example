# Published only on localhost to avoid exposing an unauthenticated inference API.
MOSS_VLLM_PORT=18000
MOSS_API_PORT=17860
MOSS_MAX_UPLOAD_BYTES=104857600
# RTX 5090 32 GB 跑 90 分鐘音檔時建議維持 1。
MOSS_MAX_CONCURRENT_JOBS=1
# 若要從其他前端呼叫 API，請填入以逗號分隔的明確來源。
MOSS_CORS_ORIGINS=*
# vLLM accepts uploads to 100 MiB and decodes clips up to 90 minutes.
# These are configured in compose.yaml; uncomment only to customize them.
# VLLM_MAX_AUDIO_CLIP_FILESIZE_MB=100
# VLLM_MAX_AUDIO_DECODE_DURATION_S=5400
# Optional overrides for locally built images.
# MOSS_VLLM_IMAGE=moss-asr-vllm:cu130-moss-pinned
# MOSS_API_IMAGE=myyang0915/moss-transcribe-diarize-api:v14

# Local benchmark data: audio and JSONL/CSV manifests are mounted read-only.
# MOSS_BENCHMARK_HOST_DIR=./benchmarks
# MOSS_MAX_BENCHMARK_SAMPLES=200
# Optional override when an API gateway applies User-Agent filtering.
# LITELLM_USER_AGENT=Mozilla/5.0 ...

# Optional LiteLLM-backed streaming proofreading. Do not commit a real key.
LITELLM_API_BASE=https://litellm.my-yang.online/v1
LITELLM_MODEL=deepseek-v4-flash
# LITELLM_API_KEY=replace-with-a-new-key
